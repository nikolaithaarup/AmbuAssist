# Canonical origin used by Expo Router for absolute web URLs.
EXPO_PUBLIC_APP_ORIGIN=https://ambuassist-staging.synapsestudio.dk

# Dedicated Firebase web app configuration for this environment.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# SynapsePortal product-session contract endpoints.
EXPO_PUBLIC_PORTAL_SESSION_URL=https://portal-staging.synapsestudio.dk/api/auth/product-session
EXPO_PUBLIC_PORTAL_LOGIN_URL=https://portal-staging.synapsestudio.dk/login

# Optional override; defaults to the public Dataforsyningen reverse-geocoder.
EXPO_PUBLIC_DESTINATION_GEOCODER_URL=
